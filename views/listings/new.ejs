<%layout("/layouts/boilerplate")%>
<div class="row">
    <div class="col-8 offset-2">
     <h3>Create a New Stayria</h3>
     <br>
     <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
           <label for="title" class= "form-label">Title</label>
           <input name="listing[title]" placeholder="Add a catchy title" type="text" class="form-control" required>
           <div class="valid-feedback">Title looks good!!</div>
        </div>
      <div class="mb-3">
         <label for="description" class="form-label">Description</label>
         <textarea name="listing[description]" placeholder="Describe what makes your place special" class="form-control" required></textarea>
         <div class="invalid-feedback">Please enter a short description</div>
       </div>
       <div class="mb-3">
         <label for="listing-images" class= "form-label">Upload Listing Images</label>
         <input 
          id="listing-images"
          name="listing[images]" 
          type="file" 
          class="form-control"
          multiple
          accept="image/png, image/jpeg, image/jpg"
          required>
         <div class="form-text text-muted">You can upload up to 5 images. The first image will be the primary cover photo.</div>

         <!-- Staged images preview section -->
         <div id="new-images-preview-section" class="mt-3" style="display: none;">
             <label class="form-label text-muted small fw-bold">Selected Images (<span id="staged-count">0</span>/5):</label>
             <div id="new-images-preview-grid" class="edit-image-grid"></div>
         </div>
       </div>
       <div class="row">
          <div class="mb-3 col-4">
             <label for="price" class="form-label">Price</label>
             <input name="listing[price]" placeholder="1200" type="number" min="0" class="form-control" required>
             <div class="invalid-feedback">Price should be valid</div>
           </div>
           <div class="mb-3 col-4">
             <label for="maxGuests" class="form-label">Max Guests</label>
             <input name="listing[maxGuests]" type="number" min="1" placeholder="4" class="form-control" required>
             <div class="invalid-feedback">Please enter a valid guest capacity</div>
           </div>
           <div class="mb-3 col-4">
               <label for="country" class="form-label">Country</label>
               <input name="listing[country]" placeholder="India" type="text" class="form-control" required>
               <div class="invalid-feedback">Country should be valid</div>
            </div>
       </div>
       
       <div class="mb-3">
         <label for="location" class="form-label">Location</label>
         <input name="listing[location]" placeholder="Jaipur,Rajasthan" type="text" class="form-control" required>
         <div class="invalid-feedback">Location should be valid</div>
        </div>

        <div class="mb-3">
         <label class="form-label">Category</label>
         <select name="listing[category]" class="form-control" required>
           <option value="">Select category</option>
           <option value="trending">Trending</option>
           <option value="rooms">Rooms</option>
           <option value="iconic">Iconic Cities</option>
           <option value="mountains">Mountains</option>
           <option value="castles">Castles</option>
           <option value="pools">Amazing Pools</option>
           <option value="camping">Camping</option>
           <option value="farms">Farms</option>
           <option value="arctic">Arctic</option>
         </select>
         <div class="invalid-feedback">Please select a category</div>
        </div>
      <br></br> 
      <button class="btn btn-dark add-btn">Create Listing</button>
      <br><br/>
      </form>
    </div>
</div>

<script>
  const imageInput = document.getElementById("listing-images");
  const previewSection = document.getElementById("new-images-preview-section");
  const previewGrid = document.getElementById("new-images-preview-grid");
  const stagedCountSpan = document.getElementById("staged-count");
  const form = imageInput ? imageInput.closest("form") : null;

  let stagedFiles = [];

  if (imageInput) {
    imageInput.addEventListener("change", function(e) {
      const selectedFiles = Array.from(e.target.files);
      if (!selectedFiles.length) return;

      selectedFiles.forEach(file => {
        if (file.type.startsWith("image/") && stagedFiles.length < 5) {
          stagedFiles.push(file);
        }
      });

      // Clear input so user can add more files consecutively
      imageInput.value = "";
      renderPreviews();
    });
  }

  function renderPreviews() {
    previewGrid.innerHTML = "";
    if (stagedCountSpan) stagedCountSpan.textContent = stagedFiles.length;

    if (stagedFiles.length === 0) {
      previewSection.style.display = "none";
      return;
    }

    previewSection.style.display = "block";

    stagedFiles.forEach((file, index) => {
      const wrapper = document.createElement("div");
      wrapper.className = "edit-image-wrapper";

      const removeBtn = document.createElement("button");
      removeBtn.type = "button";
      removeBtn.className = "delete-img-btn";
      removeBtn.title = "Remove this photo";
      removeBtn.innerHTML = '<i class="fa-solid fa-xmark"></i>';
      removeBtn.style.border = "none";

      removeBtn.addEventListener("click", function() {
        stagedFiles.splice(index, 1);
        renderPreviews();
      });

      const img = document.createElement("img");
      img.src = URL.createObjectURL(file);
      img.alt = file.name;

      if (index === 0) {
        const coverBadge = document.createElement("span");
        coverBadge.className = "new-img-tag";
        coverBadge.style.background = "#fe424d";
        coverBadge.textContent = "Cover";
        wrapper.appendChild(coverBadge);
      }

      wrapper.appendChild(removeBtn);
      wrapper.appendChild(img);
      previewGrid.appendChild(wrapper);
    });
  }

  if (form) {
    form.addEventListener("submit", function(e) {
      if (stagedFiles.length > 0) {
        const dataTransfer = new DataTransfer();
        stagedFiles.forEach(file => {
          dataTransfer.items.add(file);
        });
        imageInput.files = dataTransfer.files;
      }
    });
  }
</script>
