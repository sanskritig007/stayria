<% layout("/layouts/boilerplate") %>

<!-- ─── Subnav: Horizontal Category Filters & Right Controls ─── -->
<div class="subnav-container">
  
  <div class="category-scroll-wrapper">
    <!-- Scroll Left Button -->
    <button type="button" class="filter-scroll-btn prev-btn hidden" id="filter-prev-btn" aria-label="Scroll left">
      <i class="fa-solid fa-chevron-left"></i>
    </button>

    <!-- Scrollable Categories Track -->
    <div class="filters-scroll">
      <a href="/listings?category=trending" class="filter-item <%= typeof currentCategory !== 'undefined' && currentCategory === 'trending' ? 'active' : '' %>">
        <i class="fa-solid fa-fire"></i>
        <span>Trending</span>
      </a>

      <a href="/listings?category=rooms" class="filter-item <%= typeof currentCategory !== 'undefined' && currentCategory === 'rooms' ? 'active' : '' %>">
        <i class="fa-solid fa-bed"></i>
        <span>Rooms</span>
      </a>

      <a href="/listings?category=iconic" class="filter-item <%= typeof currentCategory !== 'undefined' && currentCategory === 'iconic' ? 'active' : '' %>">
        <i class="fa-solid fa-mountain-city"></i>
        <span>Iconic Cities</span>
      </a>

      <a href="/listings?category=mountains" class="filter-item <%= typeof currentCategory !== 'undefined' && currentCategory === 'mountains' ? 'active' : '' %>">
        <i class="fa-solid fa-mountain"></i>
        <span>Mountains</span>
      </a>

      <a href="/listings?category=castles" class="filter-item <%= typeof currentCategory !== 'undefined' && currentCategory === 'castles' ? 'active' : '' %>">
        <i class="fa-brands fa-fort-awesome"></i>
        <span>Castles</span>
      </a>

      <a href="/listings?category=pools" class="filter-item <%= typeof currentCategory !== 'undefined' && currentCategory === 'pools' ? 'active' : '' %>">
        <i class="fa-solid fa-person-swimming"></i>
        <span>Amazing pools</span>
      </a>

      <a href="/listings?category=camping" class="filter-item <%= typeof currentCategory !== 'undefined' && currentCategory === 'camping' ? 'active' : '' %>">
        <i class="fa-solid fa-campground"></i>
        <span>Camping</span>
      </a>

      <a href="/listings?category=farms" class="filter-item <%= typeof currentCategory !== 'undefined' && currentCategory === 'farms' ? 'active' : '' %>">
        <i class="fa-solid fa-cow"></i>
        <span>Farms</span>
      </a>

      <a href="/listings?category=arctic" class="filter-item <%= typeof currentCategory !== 'undefined' && currentCategory === 'arctic' ? 'active' : '' %>">
        <i class="fa-regular fa-snowflake"></i>
        <span>Arctic</span>
      </a>
    </div>

    <!-- Scroll Right Button -->
    <button type="button" class="filter-scroll-btn next-btn hidden" id="filter-next-btn" aria-label="Scroll right">
      <i class="fa-solid fa-chevron-right"></i>
    </button>
  </div>

  <!-- Right Actions (Tax Toggle) -->
  <div class="subnav-right-controls">
    <div class="tax-toggle-capsule">
      <div class="form-check form-switch m-0 p-0 d-flex align-items-center gap-3">
        <label class="form-check-label" for="taxSwitchDefault">Display total after taxes</label>
        <input class="form-check-input m-0" type="checkbox" role="switch" id="taxSwitchDefault">
      </div>
    </div>
  </div>

</div>

<!-- Mapbox Explore Map View (Hidden by default, toggled via floating button) -->
<div class="mapbox-explore-container" id="mapbox-explore-container">
  <div id="mapbox-explore-map" style="width:100%;height:100%;"></div>
</div>

<div id="listings-content-area">

<% if (typeof isSearchOrFilter !== 'undefined' && !isSearchOrFilter && typeof groupedSections !== 'undefined' && groupedSections.length > 0) { %>
  <!-- ══════════════════════════════════════════════════════════════════ -->
  <!-- 1. GROUPED DESTINATIONS MULTI-ROW VIEW (Airbnb Official Style)    -->
  <!-- ══════════════════════════════════════════════════════════════════ -->

  <% groupedSections.forEach(function(section, secIdx) { %>
    <div class="destination-row-section">
      
      <!-- Section Header -->
      <div class="destination-row-header">
        <a href="/listings?<%= section.queryParam %>" class="destination-title-link">
          <h3 class="destination-title">
            <%= section.title %>
            <span class="section-arrow-circle"><i class="fa-solid fa-chevron-right"></i></span>
          </h3>
        </a>
        <div class="row-scroll-controls">
          <button type="button" class="row-nav-btn prev-row-btn" data-target="track-sec-<%= secIdx %>" aria-label="Scroll previous">
            <i class="fa-solid fa-chevron-left"></i>
          </button>
          <button type="button" class="row-nav-btn next-row-btn" data-target="track-sec-<%= secIdx %>" aria-label="Scroll next">
            <i class="fa-solid fa-chevron-right"></i>
          </button>
        </div>
      </div>

      <!-- Horizontal Cards Track -->
      <div class="destination-cards-track" id="track-sec-<%= secIdx %>">
        <% for(let listing of section.listings) { %>
          <%
            let imgs = [];
            if (listing.images && listing.images.length > 0) {
              imgs = listing.images.map(i => i.url);
            } else if (listing.image && listing.image.url) {
              imgs = [listing.image.url];
            }

            let isSaved = false;
            if (currUser && currUser.wishlist && currUser.wishlist.includes(listing._id)) {
              isSaved = true;
            }

            let avgRating = null;
            if (listing.reviews && listing.reviews.length > 0) {
              const sum = listing.reviews.reduce((acc, r) => acc + (r.rating || 0), 0);
              avgRating = (sum / listing.reviews.length).toFixed(2);
            }
          %>

          <div class="row-card-item">
            <a href="/listings/<%= listing._id %>" class="listing-link">
              <div class="card listing-card">
                
                <!-- Image Box / Carousel Container -->
                <div class="card-carousel-container">
                  
                  <!-- Floating Badges -->
                  <% if (avgRating && avgRating >= 4.5) { %>
                    <div class="card-badge-container">
                      <span class="card-badge badge-guest-fav">
                        <i class="fa-solid fa-star"></i> Guest favourite
                      </span>
                    </div>
                  <% } else if (listing.category === "trending") { %>
                    <div class="card-badge-container">
                      <span class="card-badge">
                        <i class="fa-solid fa-fire text-danger"></i> Trending
                      </span>
                    </div>
                  <% } %>

                  <!-- Wishlist Heart Button -->
                  <button type="button" class="wishlist-heart-btn <%= isSaved ? 'saved' : '' %>" data-id="<%= listing._id %>" aria-label="Save listing">
                    <i class="fa-heart <%= isSaved ? 'fa-solid' : 'fa-regular' %>"></i>
                  </button>

                  <!-- Image Track -->
                  <div class="card-carousel-track">
                    <% if (imgs.length > 0) { %>
                      <% imgs.forEach(function(imgUrl) { %>
                        <div class="card-carousel-slide">
                          <img src="<%= imgUrl %>" alt="<%= listing.title %>" loading="lazy" />
                        </div>
                      <% }); %>
                    <% } else { %>
                      <div class="card-carousel-slide">
                        <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-light text-muted">
                          <i class="fa-solid fa-image fa-2x"></i>
                        </div>
                      </div>
                    <% } %>
                  </div>

                  <!-- Navigation Arrows -->
                  <% if (imgs.length > 1) { %>
                    <button type="button" class="carousel-nav-btn prev" aria-label="Previous photo">
                      <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <button type="button" class="carousel-nav-btn next" aria-label="Next photo">
                      <i class="fa-solid fa-chevron-right"></i>
                    </button>

                    <!-- Pagination Dots -->
                    <div class="carousel-dots">
                      <% imgs.forEach(function(_, dotIdx) { %>
                        <span class="carousel-dot <%= dotIdx === 0 ? 'active' : '' %>" data-index="<%= dotIdx %>"></span>
                      <% }); %>
                    </div>
                  <% } %>

                </div><!-- /card-carousel-container -->

                <!-- Card Body & Metadata -->
                <div class="card-body listing-info">
                  <h6 class="listing-card-title"><%= listing.title %></h6>

                  <div class="listing-card-meta-line">
                    <span class="price-amount" data-base-price="<%= listing.price %>">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
                    <span class="night-text">night</span>
                    <span class="dot-sep">·</span>
                    <span class="rating-text">
                      <% if (avgRating) { %>
                        ★ <%= avgRating %>
                      <% } else { %>
                        ★ New
                      <% } %>
                    </span>
                    <span class="tax-info">+18% GST</span>
                  </div>
                </div>

              </div><!-- /listing-card -->
            </a>
          </div><!-- /row-card-item -->
        <% } %>
      </div><!-- /destination-cards-track -->

    </div><!-- /destination-row-section -->
  <% }); %>

<% } else { %>

  <!-- ══════════════════════════════════════════════════════════════════ -->
  <!-- 2. FILTERED / SEARCH RESULTS GRID VIEW                             -->
  <!-- ══════════════════════════════════════════════════════════════════ -->
  <% if(allListings.length === 0) { %>
    <div class="text-center py-5">
      <i class="fa-solid fa-magnifying-glass text-muted mb-3" style="font-size: 3rem;"></i>
      <h4>No properties found</h4>
      <p class="text-muted">Try adjusting your search criteria or explore other categories.</p>
      <a href="/listings" class="btn btn-dark mt-2">Clear all filters</a>
    </div>
  <% } else { %>
    <div class="row row-cols-xl-3 row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
      <% for(let listing of allListings){ %>
        <%
          let imgs = [];
          if (listing.images && listing.images.length > 0) {
            imgs = listing.images.map(i => i.url);
          } else if (listing.image && listing.image.url) {
            imgs = [listing.image.url];
          }

          let isSaved = false;
          if (currUser && currUser.wishlist && currUser.wishlist.includes(listing._id)) {
            isSaved = true;
          }

          let avgRating = null;
          if (listing.reviews && listing.reviews.length > 0) {
            const sum = listing.reviews.reduce((acc, r) => acc + (r.rating || 0), 0);
            avgRating = (sum / listing.reviews.length).toFixed(2);
          }
        %>

        <div class="col">
          <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card listing-card">
              
              <div class="card-carousel-container">
                <% if (avgRating && avgRating >= 4.5) { %>
                  <div class="card-badge-container">
                    <span class="card-badge badge-guest-fav">
                      <i class="fa-solid fa-star"></i> Guest favourite
                    </span>
                  </div>
                <% } else if (listing.category === "trending") { %>
                  <div class="card-badge-container">
                    <span class="card-badge">
                      <i class="fa-solid fa-fire text-danger"></i> Trending
                    </span>
                  </div>
                <% } %>

                <button type="button" class="wishlist-heart-btn <%= isSaved ? 'saved' : '' %>" data-id="<%= listing._id %>" aria-label="Save listing">
                  <i class="fa-heart <%= isSaved ? 'fa-solid' : 'fa-regular' %>"></i>
                </button>

                <div class="card-carousel-track">
                  <% if (imgs.length > 0) { %>
                    <% imgs.forEach(function(imgUrl) { %>
                      <div class="card-carousel-slide">
                        <img src="<%= imgUrl %>" alt="<%= listing.title %>" loading="lazy" />
                      </div>
                    <% }); %>
                  <% } else { %>
                    <div class="card-carousel-slide">
                      <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-light text-muted">
                        <i class="fa-solid fa-image fa-2x"></i>
                      </div>
                    </div>
                  <% } %>
                </div>

                <% if (imgs.length > 1) { %>
                  <button type="button" class="carousel-nav-btn prev" aria-label="Previous photo">
                    <i class="fa-solid fa-chevron-left"></i>
                  </button>
                  <button type="button" class="carousel-nav-btn next" aria-label="Next photo">
                    <i class="fa-solid fa-chevron-right"></i>
                  </button>

                  <div class="carousel-dots">
                    <% imgs.forEach(function(_, dotIdx) { %>
                      <span class="carousel-dot <%= dotIdx === 0 ? 'active' : '' %>" data-index="<%= dotIdx %>"></span>
                    <% }); %>
                  </div>
                <% } %>

              </div><!-- /card-carousel-container -->

              <div class="card-body listing-info">
                <h6 class="listing-card-title"><%= listing.title %></h6>

                <div class="listing-card-meta-line">
                  <span class="price-amount" data-base-price="<%= listing.price %>">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
                  <span class="night-text">night</span>
                  <span class="dot-sep">·</span>
                  <span class="rating-text">
                    <% if (avgRating) { %>
                      ★ <%= avgRating %>
                    <% } else { %>
                      ★ New
                    <% } %>
                  </span>
                  <span class="tax-info">+18% GST</span>
                </div>
              </div>

            </div><!-- /listing-card -->
          </a>
        </div>
      <% } %>
    </div>
  <% } %>
<% } %>
</div><!-- /listings-content-area -->

<!-- ── Floating Map View Toggle Button ── -->
<button type="button" class="floating-map-toggle" id="floating-map-toggle-btn">
  <i class="fa-solid fa-map"></i> <span>Show map</span>
</button>

<!-- ── Stayria AI Travel Concierge Floating Button ── -->
<button type="button" class="ai-concierge-fab" id="ai-concierge-fab" aria-label="Ask Stayria AI Concierge" title="Ask Stayria AI Concierge">
  <i class="fa-solid fa-wand-magic-sparkles"></i>
</button>

<!-- ── Stayria AI Travel Concierge Modal ── -->
<div class="ai-concierge-modal" id="ai-concierge-modal">
  <div class="ai-modal-header">
    <h6><i class="fa-solid fa-wand-magic-sparkles"></i> Stayria AI Concierge</h6>
    <button type="button" class="lightbox-close-btn" id="close-ai-modal-btn" style="width:30px;height:30px;font-size:0.85rem;" aria-label="Close AI Concierge">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
  <div class="ai-modal-body">
    <p class="text-muted" style="font-size:0.85rem;margin-bottom:12px;">Where do you feel like going? Pick a vibe or personalized curation:</p>
    <div class="ai-prompt-suggestion" data-search="category=mountains">
      <span>🏔️ Peaceful Mountain Cabins</span>
      <i class="fa-solid fa-chevron-right text-muted" style="font-size:0.75rem;"></i>
    </div>
    <div class="ai-prompt-suggestion" data-search="category=pools">
      <span>🏊 Luxury Villas with Private Pool</span>
      <i class="fa-solid fa-chevron-right text-muted" style="font-size:0.75rem;"></i>
    </div>
    <div class="ai-prompt-suggestion" data-search="category=castles">
      <span>🏰 Royal Heritage Castles & Mansions</span>
      <i class="fa-solid fa-chevron-right text-muted" style="font-size:0.75rem;"></i>
    </div>
    <div class="ai-prompt-suggestion" data-search="category=farms">
      <span>🌿 Nature & Organic Farm Retreats</span>
      <i class="fa-solid fa-chevron-right text-muted" style="font-size:0.75rem;"></i>
    </div>
    <div class="ai-prompt-suggestion" data-search="category=trending">
      <span>🔥 Most Popular Stays This Week</span>
      <i class="fa-solid fa-chevron-right text-muted" style="font-size:0.75rem;"></i>
    </div>
  </div>
</div>

<script>
  window.mapToken = "<%= process.env.MAP_TOKEN %>";
  window.stayriaMapListings = <%- JSON.stringify(allListings.map(l => ({
    id: l._id,
    title: l.title,
    price: l.price,
    image: (l.images && l.images[0] ? l.images[0].url : (l.image ? l.image.url : '')),
    coordinates: (l.geometry && l.geometry.coordinates && l.geometry.coordinates.length >= 2) ? l.geometry.coordinates : [77.209, 28.6139]
  }))) %>;
</script>

<script>
  // ─── 1. Wishlist AJAX Toggle ───
  document.querySelectorAll('.wishlist-heart-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const currUser = <%- currUser ? 'true' : 'false' %>;
      if (!currUser) {
        window.location.href = '/login';
        return;
      }

      const listingId = btn.getAttribute('data-id');
      const icon = btn.querySelector('i');

      try {
        const response = await fetch(`/wishlist/${listingId}/toggle`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        if (data.success) {
          if (data.wishlisted) {
            btn.classList.add('saved');
            icon.classList.remove('fa-regular');
            icon.classList.add('fa-solid');
          } else {
            btn.classList.remove('saved');
            icon.classList.remove('fa-solid');
            icon.classList.add('fa-regular');
          }
        }
      } catch (error) {
        console.error('Error toggling wishlist:', error);
      }
    });
  });

  // ─── 2. Tax Toggle Switch ───
  const taxSwitch = document.getElementById("taxSwitchDefault");
  if (taxSwitch) {
    taxSwitch.addEventListener("change", () => {
      const taxInfoElements = document.querySelectorAll(".tax-info");
      taxInfoElements.forEach(info => {
        info.style.display = taxSwitch.checked ? "inline" : "none";
      });
    });
  }
</script>